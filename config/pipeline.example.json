{
  "version": 5,
  "oxr": {
    "mode": "free_api",
    "base_url": "",
    "free_api_base_url": "https://free-oxr.somark.ai/api/v1",
    "local_base_url": "http://127.0.0.1:8000/v1",
    "api_key": "",
    "timeout_sec": 600,
    "max_retries": 5,
    "backoff_sec": 10.0,
    "element_formats": {
      "image": "none",
      "formula": "latex",
      "table": "markdown",
      "cs": "smiles"
    },
    "feature_config": {
      "keep_header_footer": false
    },
    "extra": {
      "temperature": 0.0
    }
  },
  "chunking": {
    "max_pages": 20,
    "max_bytes": 9437184,
    "max_concurrent": 2,
    "render_dpi": 200,
    "chunk_retries": 3
  },
  "curation": {
    "enabled": true,
    "section_drop": [
      "references",
      "bibliography",
      "index",
      "preface",
      "foreword",
      "acknowledgements",
      "acknowledgment",
      "table of contents",
      "contents"
    ],
    "section_drop_prefix": [
      "appendix",
      "acknowledg",
      "about the author"
    ],
    "page_drop": [
      "copyright",
      "all rights reserved",
      "isbn",
      "published by",
      "doi:",
      "printed in"
    ],
    "drop_before_first_heading": true,
    "first_heading_max_page": 60,
    "toc_min_lines": 8,
    "toc_min_ratio": 0.5,
    "front_matter_max_chars": 2000
  },
  "lifecycle": {
    "prune_temp": true,
    "done_folder": "_done",
    "failed_folder": "_failed",
    "delete_source": false,
    "failed_run_limit": 5
  },
  "output": {
    "figure_marker": false
  }
}
