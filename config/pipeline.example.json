{
  "version": 3,
  "oxr": {
    "mode": "free_api",
    "base_url": "",
    "free_api_base_url": "https://free-oxr.somark.ai/api/v1",
    "local_base_url": "http://127.0.0.1:8000/v1",
    "api_key": "",
    "timeout_sec": 600,
    "max_retries": 5,
    "backoff_sec": 10.0,
    "element_formats": {
      "image": "none",
      "formula": "latex",
      "table": "markdown",
      "cs": "smiles"
    },
    "feature_config": {
      "keep_header_footer": false
    },
    "extra": {
      "temperature": 0.0
    }
  },
  "chunking": {
    "max_pages": 20,
    "max_bytes": 9437184,
    "max_concurrent": 2,
    "render_dpi": 200,
    "chunk_retries": 3
  },
  "output": {
    "add_page_markers": true,
    "page_separator": "---",
    "figure_marker": false
  }
}
